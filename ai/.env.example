# AI Microservice Configuration
PORT=8001
HOST=0.0.0.0
USE_MOCK_AI=true

# Google Gemini API (Primary Vision & Intent Provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq API (Ultra-fast multimodal vision & LLM inference fallback)
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Telegram Bot Gateway (Task A - Optional for live group chats)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=TripSheriffBot

# Cross-Service Bridge
BACKEND_URL=http://localhost:8080
WEB_SIMULATOR_URL=http://localhost:5173

# Security / CORS
ALLOWED_ORIGINS=*
